{
  "name": "typink",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @typink/mac dev",
    "build": "pnpm --filter @typink/mac build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "icon": "node --no-warnings scripts/icon/make-icon.mts",
    "bump": "node --no-warnings scripts/bump-version.mts",
    "release:mac": "node --no-warnings scripts/release-mac.mts",
    "release:ipad": "scripts/release-ipad.sh"
  }
}
