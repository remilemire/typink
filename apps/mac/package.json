{
  "name": "@typink/mac",
  "productName": "Typink",
  "version": "1.0.0",
  "private": true,
  "description": "Typink: Typst notes with Apple Pencil ink from your iPad",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fake-ipad": "node scripts/fake-ipad.mts",
    "dist": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "e2e": "electron-vite build && node e2e/run.mts",
    "smoke": "node e2e/packaged.mts"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@typink/protocol": "workspace:*",
    "@typink/typst-lib": "workspace:*",
    "@vitejs/plugin-react": "5.2.0",
    "codemirror-lang-typst": "0.6.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
